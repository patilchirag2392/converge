# Converge -- the environment file that lives ON the EC2 box.
#
# Copy this to /opt/converge/.env on the instance and fill it in there. It is
# never committed: the repo's .gitignore already covers `.env`, and this
# template exists so the real file can be written from something rather than
# from memory.
#
#   THE RULE: this file's *contents* only ever exist on the box.
#
# Which means, concretely, all of the following are wrong:
#   - putting the password in EC2 user-data (readable forever at
#     http://169.254.169.254/latest/user-data from inside the instance, and via
#     `aws ec2 describe-instance-attribute --attribute userData` from outside)
#   - baking it into a Docker image (it stays in the layer history even if a
#     later layer removes it -- same additive-layers reason as Stage 4)
#   - passing it on the `docker compose` command line (visible in `ps`)
#   - committing it "temporarily"  (it is in the reflog forever)
#
# docker-compose.prod.yml refuses to start if POSTGRES_PASSWORD or PUBLIC_HOST
# is missing, so a half-filled file fails loudly instead of silently running
# with a default credential on a public box.

# --- Required -----------------------------------------------------------------

# The public hostname browsers will use. Whatever you type in the address bar.
#
# Either the instance's public DNS name:
#   PUBLIC_HOST=ec2-1-2-3-4.compute-1.amazonaws.com
# or an Elastic IP / your own domain:
#   PUBLIC_HOST=converge.example.com
#
# This is baked into the client bundle at build time (Vite inlines
# import.meta.env.VITE_*), so CHANGING IT REQUIRES A REBUILD, not a restart:
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# That matters because a stop/start of the instance gives it a NEW public DNS
# name unless you attached an Elastic IP. Get it wrong and the page loads but
# the socket never connects -- the pill stays "connecting".
PUBLIC_HOST=

# Generate it on the box, don't invent one and don't reuse one:
#   openssl rand -base64 24
#
# Only ever read by Postgres (to create the role on first boot) and by the two
# server containers (in DATABASE_URL). It is not a user-facing credential.
#
# Note: this is consumed by `initdb`, which runs ONLY on the very first boot of
# a fresh volume. Changing it later does not change the database's password --
# the servers will just fail to authenticate. See the runbook.
POSTGRES_PASSWORD=

# --- Optional (sensible defaults in docker-compose.yml) -----------------------

# The single published port. 80 in production. Override only when testing this
# same overlay locally, where binding 80 may need privileges:
#   PUBLIC_PORT=8081
#PUBLIC_PORT=80

#POSTGRES_USER=converge
#POSTGRES_DB=converge

# Seconds the servers keep retrying Postgres and Redis at startup. The default
# is fine; a very small instance under memory pressure may want more.
#CONVERGE_CONNECT_TIMEOUT=30

# INFO shows the startup sequence in `docker compose logs`, which is how you
# diagnose anything on a box you can only reach over SSH. WARNING for quiet.
#LOG_LEVEL=INFO
