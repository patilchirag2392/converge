# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
# Templates are the exception, and the glob has to cover all of them.
# `!.env.example` alone silently ignored deploy/aws/.env.production.example,
# which bootstrap.sh copies on the box -- so the file existed locally, was never
# committed, and the deploy would have failed with "no such file". Caught with
# `git check-ignore -v` before the first commit; worth remembering that an
# ignored file you depend on fails somewhere else entirely.
!.env*.example

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Stage 3 cluster runtime (nginx logs, pidfiles)
deploy/.run/

# e2e driver (installed on demand, see e2e/README.md)
e2e/node_modules/
e2e/package.json
e2e/package-lock.json
