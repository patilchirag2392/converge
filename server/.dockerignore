# Keep the build context small and the image reproducible.
#
# Everything excluded here is either (a) host-specific and would poison the
# image, or (b) irrelevant to running the server. A smaller context also means
# fewer spurious cache invalidations: touching a test file shouldn't rebuild the
# dependency layer.

# A host virtualenv holds macOS/arm64 binaries and absolute paths from this
# machine. Copying it into a Linux image is the classic way to get an image that
# builds and then cannot import anything.
.venv/
venv/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Tests and demo scripts deliberately do NOT ship in the runtime image -- they
# are dev-time tools, they pull in the dev dependency group, and the CI job runs
# them on the runner instead. See NOTES.md.
tests/
scripts/

.env
.env.*
!.env.example
.DS_Store
