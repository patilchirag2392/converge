# Converge -- docker-compose configuration.
#
#   cp .env.example .env      then edit
#
# Every one of these has a working default baked into docker-compose.yml, so
# `docker compose up` works with no .env at all. This file exists to document
# what is configurable and to be the thing you copy when a value has to change.
#
# .env is gitignored; .env.example is not. Nothing secret belongs in here --
# the Postgres password below is a local development default, and Stage 5 will
# need a real secret store rather than a file.

# --- Postgres ---------------------------------------------------------------
# Consumed by the postgres container to create the role and database on first
# boot, and interpolated into DATABASE_URL for the servers. Changing these
# after the volume exists will NOT re-run initdb -- `docker compose down -v`
# first, or the servers will fail to authenticate against the old credentials.
POSTGRES_USER=converge
POSTGRES_PASSWORD=converge
POSTGRES_DB=converge

# --- Ports ------------------------------------------------------------------
# Host-side only; the container-side ports never change. Worth overriding if
# something is already listening -- the Homebrew Postgres on 5432, a `vite dev`
# on 5173, or scripts/cluster.sh's nginx on 8080.
CLIENT_PORT=5173
LB_PORT=8080
SERVER_A_PORT=8001
SERVER_B_PORT=8002

# Postgres and Redis are published on deliberately NON-default host ports. The
# app never uses these -- the servers reach both over the compose network -- but
# host-side tooling does. The odd numbers are the safety feature: on 5432/6379
# these would collide with the Homebrew services, and a host-side query could
# silently hit the wrong database and report an empty document.
#
#   psql "postgresql://converge:converge@localhost:55432/converge"
#   redis-cli -p 56379 monitor
POSTGRES_PORT=55432
REDIS_PORT=56379

# Point the demo scripts at the containerised Postgres rather than the
# Homebrew one. Without this, `multi_instance_demo.py` reads the local dev
# database and its "straight from Postgres" line comes back empty.
#
#   DATABASE_URL=postgresql://converge:converge@localhost:55432/converge \
#     uv run python scripts/multi_instance_demo.py

# --- Client -----------------------------------------------------------------
# Where the browser opens its WebSocket. This is a BUILD argument, not a
# runtime variable: Vite inlines import.meta.env.VITE_* into the bundle, so
# changing it requires `docker compose build client`, not just a restart.
#
# It must point at the load balancer, not at an instance -- routing across
# instances is the thing Stage 3 exists to demonstrate.
VITE_WS_URL=ws://localhost:8080

# --- Server -----------------------------------------------------------------
# Seconds the server keeps retrying Postgres and Redis at startup before giving
# up. This is the app-level half of the startup-ordering answer; compose's
# healthchecks are the other half. 0 restores fail-on-first-attempt.
CONVERGE_CONNECT_TIMEOUT=30

# Server log level. INFO shows the startup sequence -- connecting to Postgres,
# schema applied, bus started, per-document subscribes -- which is what makes a
# startup-ordering problem legible in `docker compose logs`. WARNING for quiet.
LOG_LEVEL=INFO
